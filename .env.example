DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM="CoConnect <noreply@example.com>"
CRON_SECRET=
# Error reporting (optional). Server: SENTRY_DSN. Browser: NEXT_PUBLIC_SENTRY_DSN (same DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# hCaptcha (optional). Site key shows the widget; the secret is checked server-side
# for phone codes and job submission. Put the same secret in Supabase → Auth → Bot protection.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
